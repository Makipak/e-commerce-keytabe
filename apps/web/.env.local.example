NEXT_PUBLIC_API_URL=http://localhost:4000
# URL API dari sudut pandang server Next.js sendiri (SSR/ISR + proxy /uploads).
# Saat demo ngrok, Next dan API jalan di mesin yang sama → pakai localhost,
# jangan lewat tunnel ngrok (lebih cepat & tidak kena limit bandwidth free plan).
API_INTERNAL_URL=http://localhost:4000
# Harus sama dengan REVALIDATE_SECRET di apps/api/.env
REVALIDATE_SECRET=ganti-random-sama-dengan-api

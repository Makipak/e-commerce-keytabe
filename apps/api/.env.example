# Postgres (Supabase/Neon/lokal)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keytabee

# Auth admin
JWT_SECRET=ganti-dengan-random-panjang

# Xendit (test mode dulu)
XENDIT_SECRET_KEY=xnd_development_xxx
XENDIT_CALLBACK_TOKEN=xxx

# RajaOngkir via Komerce (rajaongkir.komerce.id)
KOMERCE_API_KEY=xxx
SHIPPING_ORIGIN_DISTRICT_ID=0

# WhatsApp notif
FONNTE_TOKEN=xxx
OWNER_WA_NUMBER=628xxxxxxxxxx

FRONTEND_URL=http://localhost:3000
PORT=4000

# URL publik API (untuk URL gambar upload). Di production: https://api.domain.com
API_PUBLIC_URL=http://localhost:4000

# On-demand revalidation cache storefront. Harus sama dgn REVALIDATE_SECRET di apps/web
REVALIDATE_SECRET=ganti-random-sama-dengan-web
# Folder penyimpanan gambar (default: ./uploads di apps/api)
# UPLOAD_DIR=
